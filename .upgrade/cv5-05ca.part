  function inferScenarioRoles(raw, entityList) {
    const q = qnorm(raw);
    const positioned = entityList.map(entry => {
      const names = entryNames(entry).sort((a, b) => b.length - a.length);
      let name = names.find(candidate => namePosition(q, candidate) >= 0) || null;
      let index = name ? namePosition(q, name) : -1;
      if (index < 0) {
        const special = SPECIAL_REFERENCES.find(reference => reference.id === entry.id && namePosition(q, reference.phrase) >= 0);
        if (special) { name = special.phrase; index = namePosition(q, special.phrase); }
      }
      return { entry, index, name: name || qnorm(entry.title) };
    }).filter(item => item.index >= 0).sort((a, b) => a.index - b.index);
