t");
  if (el) el.textContent = `${liveArticleCount.toLocaleString()}+`;
}

async function liveWikiSearch(query, limit = 7) {
  const key = normalize(query);
  const cached = getLiveCache()[key];
  if (cached && Date.now() - cached.time < 1000 * 60 * 60 * 24 * 7) return cached.value;

  const search = cleanWikiQuery(query);
  const params = new URLSearchParams({
    action: "query",
    generator: "search",
    gsrsearch: search,
    gsrnamespace: "0",
    gsrlimit: String(limit),
    prop: "extracts|info",
    exintro: "1",
    explaintext: "1",
    exsentences: "4",
    inprop: "url",
    redirects: "1",
    format: "json",
    origin: "*"
  });
  const data = await fetchJson(`${WIKI_API}?${params.toString()}`);
  const pages = Object.values(data?.query?.pages || {})
    .filter(page => page?.title && !/^(Category|Template|File|User|Forum|Thread):/i.test(page.title))
    .sort((a,b) => (a.index || 999) - (b.index || 999))
    .map(page => ({
      id: `wiki-${page.pageid}`,
      title: page.title,
      extract: shorten(page.extract || page.description || "", 520),
      description: shorten(page.description || "", 150),
      url: page.fullurl || `${WIKI_HOME}${encodeURIComponent(page.title.replace(/ /g,"_"))}`,
      source: "Jujutsu Kaisen Wiki"
    }))
    .filter(page => page.extract || page.description);
  setLiveCache(key, pages);
  return pages;
}

function renderLiveRelated(pages, primaryTitle = "") {
  const unique = pages.filter(page => normalize(page.title) !== normalize(primaryTitle)).slice(0, 7);
  if (!unique.length) return;
  $("#relatedResults").innerHTML = unique.map(page => `
    <article class="live-related-card">
      <div class="entry-meta"><span class="tag purple">Live wiki</span></div>
      <h4>${escapeHtml(page.title)}</h4>
      <p>${escapeHtml(shorten(page.description || page.extract, 145))}</p>
      <a class="source-link" href="${escapeHtml(page.url)}" target="_blank" rel="noopener">Open record ↗</a>
    </article>
  `).join("");
}

