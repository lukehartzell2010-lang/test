  function classify(raw) {
    const q = qnorm(raw);
    if (/\b(?:have|has|had|did|do|does)\b.*\b(?:meet|met|fight|fought|encounter|encountered|interact|interacted|know each other|seen each other)\b|\b(?:meet|met|fought|encountered)\b/.test(q)) return "encounter";
    if (/^why\b.*\b(?:not|never|could not|would not|did not|does not|has not|have not)\b|^why did\b|^why does\b|^why was\b|^why is\b/.test(q)) return "motive";
    if (/\b(?:would|could|can)\b.*\b(?:die|survive|kill|beat|win|lose|tank|resist|bypass|stop|cancel|protect|work|affect|damage|hurt|hit|reach|land|escape|adapt)\b|^(?:did|has|have)\b.*\b(?:survive|die|kill|hurt|damage|escape|work)\b|\bwhat (?:would happen|happens) if\b/.test(q)) return "scenario";
    return null;
  }

