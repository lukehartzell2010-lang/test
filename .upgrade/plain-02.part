: 7px;
  flex-wrap: wrap;
  margin-bottom: 13px;
}
.tag {
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 4px 7px;
  color: #9c94a8;
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: .12em;
}
.tag.purple { color: #cdb5ff; border-color: rgba(159,102,255,.3); background: rgba(159,102,255,.08); }
.popular-card h3, .browse-card h3, .related-card h4 { margin: 0 0 8px; font-size: 15px; }
.popular-card p, .browse-card p, .related-card p { color: var(--muted); font-size: 11px; line-height: 1.6; margin: 0; }

#resultsView, #browseView { padding: 34px clamp(22px, 6vw, 88px) 70px; }
.back-button { padding: 0; margin: 14px 0 42px; }

.results-hero {
  max-width: 1000px;
  margin-bottom: 26px;
}
.results-hero h2 { font-size: clamp(34px, 5vw, 62px); line-height: 1.06; }
.breakdown { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
.break-chip {
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 7px 10px;
  color: var(--muted);
  background: rgba(255,255,255,.018);
  font-size: 10px;
}
.break-chip b { color: white; margin-left: 5px; }

.results-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(270px, .7fr);
  gap: 18px;
  align-items: start;
}
.answer-panel, .related-panel {
  border: 1px solid var(--border);
  border-radius: 24px;
  background: rgba(15,12,22,.75);
}
.answer-panel { padding: clamp(20px, 4vw, 34px); }
.related-panel { padding: 22px; }
.panel-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--purple);
  text-transform: uppercase;
  letter-spacing: .16em;
  font-size: 9px;
  margin-bottom: 28px;
}
.icon-button {
  border: 1px solid var(--border);
  background: transparent;
  width: 32px; height: 32px;
  border-radius: 9px;
  cursor: pointer;
}
.icon-button:hover { border-color: rgba(159,102,255,.45); color: #cfb8ff; }

.answer-title {
  font-family: Georgia, serif;
  font-size: clamp(30px, 4vw, 47px);
  font-weight: 500;
  line-height: 1.05;
  margin: 0 0 18px;
}
.answer-lede {
  color: #ded9e7;
  font-size: 16px;
  line-height: 1.8;
  margin: 0 0 25px;
}
.answer-section {
  border-top: 1px solid var(--border);
  padding-top: 20px;
  margin-top: 20px;
}
.answer-section h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .14em; color: var(--purple); }
.answer-section p, .answer-section li { color: var(--muted); line-height: 1.75; font-size: 13px; }
.answer-section ul { padding-left: 18px; }
.answer-note {
  border: 1px solid rgba(159,102,255,.2);
  background: rgba(159,102,255,.06);
  padding: 14px;
  border-radius: 14px;
  color: #c9bed9;
  font-size: 12px;
  line-height: 1.6;
}
.compare-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 14px;
  align-items: stretch;
}
.compare-card {
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
  background: rgba(255,255,255,.018);
}
.compare-card h3 { margin: 0 0 10px; font-family: Georgia, serif; font-size: 25px; }
.compare-card p { color: var(--muted); line-height: 1.65; font-size: 12px; }
.versus { display: grid; place-items: center; color: var(--purple); font-weight: 900; }

.related-heading { margin-bottom: 16px; }
.related-heading h3 { margin: 7px 0 0; font-family: Georgia, serif; font-size: 24px; font-weight: 500; }
#relatedResults { display: grid; gap: 9px; }
.related-card { padding: 14px; border-radius: 14px; }

.browse-header { margin-bottom: 24px; }
.mini-search {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(255,255,255,.018);
  padding: 9px 12px;
}
.mini-search input {
  border: 0;
  outline: 0;
  color: white;
  background: transparent;
  min-width: 220px;
}
.browse-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.browse-card { min-height: 165px; }

.toast {
  position: fixed;
  left: 50%;
  bottom: 24px;
  transform: translate(-50%, 20px);
  border: 1px solid var(--border);
  background: rgba(15,12,22,.96);
  color: white;
  padding: 10px 14px;
  border-radius: 999px;
  font-size: 11px;
  opacity: 0;
  pointer-events: none;
  transition: .25s ease;
  z-index: 100;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

.empty-state {
  grid-column: 1 / -1;
  border: 1px dashed var(--border);
  border-radius: 18px;
  padding: 40px;
  color: var(--muted);
  text-align: center;
}

@media (max-width: 1100px) {
  :root { --sidebar: 218px; }
  .hero-grid, .browse-grid { grid-template-columns: repeat(2, 1fr); }
  .category-grid, .popular-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 760px) {
  .sidebar {
    transform: translateX(-104%);
    transition: .25s ease;
    width: 260px;
    box-shadow: 24px 0 70px rgba(0,0,0,.5);
  }
  body.menu-open .sidebar { transform: translateX(0); }
  .main-shell { margin-left: 0; }
  .mobile-menu {
    display: block;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.02);
    border-radius: 10px;
    width: 38px; height: 38px;
  }
  .topbar { padding: 0 16px; }
  .status-pill { display: none; }
  .hero { padding-top: 62px; }
  .search-box {
    grid-template-columns: auto 1fr auto;
    min-height: 62px;
    padding-left: 14px;
  }
  .search-box kbd { display: none; }
  .search-box > button { width: 46px; height: 46px; }
  .prompt-row { overflow-x: auto; flex-wrap: nowrap; padding-bottom: 8px; }
  .prompt-chip { white-space: nowrap; }
  .hero-grid, .category-grid, .popular-grid, .browse-grid { grid-template-columns: 1fr; }
  .results-layout { grid-template-columns: 1fr; }
  .compare-grid { grid-template-columns: 1fr; }
  .versus { min-height: 20px; }
  .browse-header { align-items: stretch; flex-direction: column; gap: 18px; }
  .mini-search input { min-width: 0; width: 100%; }
}


.live-source{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(125,249,164,.22);background:rgba(125,249,164,.06);color:#bdfbcf;border-radius:999px;padding:6px 9px;font-size:9px;letter-spacing:.1em;text-transform:uppercase}.live-source i{width:6px;height:6px;border-radius:50%;background:#7df9a4;box-shadow:0 0 10px #7df9a4}.source-link{display:inline-flex;align-items:center;gap:6px;margin-top:12px;color:#cdb5ff;text-decoration:none;font-size:11px;border-bottom:1px solid rgba(159,102,255,.3);padding-bottom:2px}.source-link:hover{color:white}.live-records{display:grid;gap:10px;margin-top:14px}.live-record{border:1px solid var(--border);border-radius:15px;padding:14px;background:rgba(255,255,255,.018)}.live-record h4{margin:0 0 7px;font-size:14px;color:#f5f0ff}.live-record p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}.loading-orb{width:38px;height:38px;border-radius:50%;border:2px solid rgba(159,102,255,.18);border-top-color:#9f66ff;animation:spin .8s linear infinite;margin-bottom:18px}@keyframes spin{to{transform:rotate(360deg)}}.live-fail{border:1px solid rgba(255,110,143,.22);background:rgba(255,110,143,.05);border-radius:14px;padding:13px;color:#d9b7c0;font-size:12px;line-height:1.6}.network-note{color:#7e778a;font-size:10px;margin-top:10px}.wiki-attribution{font-size:10px;color:#7f788c;line-height:1.55;margin-top:15px}.wiki-attribution a{color:#aa8adb}.live-related-card{border:1px solid var(--border);background:linear-gradient(145deg,rgba(125,249,164,.045),rgba(255,255,255,.007));border-radius:14px;padding:14px;text-align:left}.live-related-card h4{margin:0 0 7px;font-size:14px}.live-related-card p{color:var(--muted);font-size:11px;line-height:1.5;margin:0}.live-related-card a{color:inherit;text-decoration:none}.status-pill b#liveCount{color:#bdfbcf}

</style>
</head>
<body>
  <div class="noise"></div>
  <div class="ambient ambient-one"></div>
  <div class="ambient ambient-two"></div>

  <aside class="sidebar" aria-label="Primary navigation">
    <button class="brand" data-action="home" aria-label="Go home">
      <span class="brand-mark">呪</span>
      <span class="brand-copy">
        <strong>JJK ARCHIVE</strong>
        <small>CURSED KNOWLEDGE INDEX</small>
      </span>
    </button>

    <nav class="nav-list">
      <button class="nav-item active" data-view="home"><span>⌂</span>Home</button>
      <button class="nav-item" data-category="character"><span>◉</span>Characters</button>
      <button class="nav-item" data-category="technique"><span>∞</span>Techniques</button>
      <button class="nav-item" data-category="domain"><span>◌</span>Domains</button>
      <button class="nav-item" data-category="curse"><span>♨</span>Curses</button>
      <button class="nav-item" data-category="arc"><span>▤</span>Arcs</button>
      <button class="nav-item" data-category="clan"><span>◇</span>Clans</button>
      <button class="nav-item" data-category="concept"><span>✦</span>Concepts</button>
    </nav>

    <div class="sidebar-card">
      <div class="sigil">◉</div>
      <strong>Spoiler filter</strong>
      <p>Anime mode protects spoilers. Full Manga unlocks the complete curated and live archive.</p>
      <div class="segmented" role="group" aria-label="Spoiler level">
        <button class="segment active" data-spoiler="anime">Anime</button>
        <button class="segment" data-spoiler="manga">Manga</button>
      </div>
    </div>

    <button class="random-button" data-action="random">↝ Random entry</button>
  </aside>

  <main class="main-shell">
    <header class="topbar">
      <button class="mobile-menu" aria-label="Open menu">☰</button>
      <div class="status-pill"><span></span><b id="entryCount">0</b> curated · <b id="liveCount">1,000+</b> live</div>
      <button class="notebook-button" data-action="saved">☆ Saved <b id="savedCount">0</b></button>
    </header>

    <section id="homeView" class="view active">
      <div class="hero">
        <div class="eyebrow">THE CURSED ENERGY REFERENCE SYSTEM</div>
        <h1>Ask anything.<br><em>Understand everything.</em></h1>
        <p class="hero-copy">
          Search a large curated knowledge graph plus the live JJK Wiki archive for characters, techniques, domains, fights, chapters, arcs, locations, and obscure terminology.
        </p>

        <form id="searchForm" class="search-box" autocomplete="off">
          <span class="search-icon">⌕</span>
          <input
            id="searchInput"
            type="search"
            placeholder="Ask any JJK related questions"
            aria-label="Ask any JJK related questions"
          />
          <kbd>Enter</kbd>
          <button type="submit" aria-label="Search">↑</button>
          <div id="autocomplete" class="autocomplete" hidden></div>
        </form>

        <div class="prompt-row">
          <span>Try asking</span>
          <button class="prompt-chip">How does Limitless work?</button>
          <button class="prompt-chip">Who is Toji Fushiguro?</button>
          <button class="prompt-chip">Explain Domain Expansion</button>
          <button class="prompt-chip">Gojo vs Sukuna</button>
        </div>

        <div class="hero-grid">
          <article class="feature-card accent">
            <div class="feature-number">01</div>
            <div>
              <small>QUERY ENGINE</small>
              <h3>Breaks down your question</h3>
              <p>Detects intent and subjects, searches the curated archive, then reaches into 1,000+ live lore articles when needed.</p>
            </div>
          </article>
          <article class="feature-card">
            <div class="feature-number">02</div>
            <div>
              <small>CONNECTED LORE</small>
              <h3>Explains relationships</h3>
              <p>Results connect characters to techniques, domains, clans, battles, and story arcs.</p>
            </div>
          </article>
          <article class="feature-card">
            <div class="feature-number">03</div>
            <div>
              <small>SPOILER CONTROL</small>
              <h3>Anime or full manga</h3>
              <p>Switch between safer anime coverage and the complete 