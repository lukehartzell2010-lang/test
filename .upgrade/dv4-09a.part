clamp(22px,4vw,34px);border-bottom:1px solid var(--border);background:radial-gradient(circle at 85% 0,rgba(159,102,255,.13),transparent 42%)}
      .dossier-head h2{font:500 clamp(31px,5vw,48px)/1.05 Georgia,serif;margin:16px 0 14px}.dossier-head>p{font-size:15px;line-height:1.8;color:#ded8e8;max-width:850px;margin:0}
      .dossier-badges{display:flex;flex-wrap:wrap;gap:7px}.dossier-badges span{border:1px solid var(--border);border-radius:999px;padding:6px 9px;font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:#bbb3c8;background:rgba(255,255,255,.025)}.dossier-badges .verified{color:#c9fbd7;border-color:rgba(125,249,164,.25);background:rgba(125,249,164,.06)}
      .dossier-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:21px}.dossier-stats span{font-size:10px;color:#898293;border:1px solid var(--border);border-radius:10px;padding:8px 10px;background:rgba(0,0,0,.12)}.dossier-stats b{color:white;margin-right:4px}
      .dossier-nav{display:flex;gap:8px;overflow-x:auto;padding:14px 18px;border-bottom:1px solid var(--border);background:rgba(5,4,9,.3);scrollbar-width:none}.dossier-nav::-webkit-scrollbar{display:none}.dossier-nav a{white-space:nowrap;color:#b8afc4;text-decoration:none;border:1px solid var(--border);border-radius:999px;padding:7px 10px;font-size:9px}.dossier-nav a:hover{color:white;border-color:rgba(159,102,255,.45)}
      .dossier-body{padding:0 clamp(20px,4vw,32px) 28px}.dossier-section{padding:25px 0;border-top:1px solid var(--border)}.dossier-section:first-child{border-top:0}.dossier-section h3{font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:#b88cff;margin:0 0 14px}.dossier-section p,.dossier-section li{color:#bdb6c9;font-size:13px;line-height:1.82}.dossier-section p{margin:0 0 13px}.dossier-section p:last-child{margin-bottom:0}.dossier-section ul{margin:8px 0 0;padding-left:20px;display:grid;gap:8px}.dossier-section b{color:#f3edff}
      .dossier-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.dossier-card{border:1px solid var(--border);border-radius:15px;background:rgba(255,255,255,.018);paddi