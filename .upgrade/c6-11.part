  const clean = value => String(value || "").trim();
  const mergeUnique = (base, additions) => {
    const seen = new Set();
    return [...(base || []), ...(additions || [])].filter(value => {
      const key = clean(value).toLowerCase();
      if (!key || seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  };

  const byId = new Map(entries.map(entry => [entry.id, entry]));
  let patched = 0;
  for (const [id, patch] of Object.entries(PATCHES)) {
    const entry = byId.get(id);
    if (!entry) continue;
    entry.keywords = mergeUnique(entry.keywords, patch.keywordsAdd);
    entry.points = mergeUnique(entry.points, patch.pointsAdd);
    entry.related = mergeUnique(entry.related, patch.relatedAdd);
    if (patch.detailsAppend && !clean(entry.details).includes(clean(patch.detailsAppend))) {
      entry.details = `${clean(entry.details)} ${clean(patch.detailsAppend)}`.trim();
    }
    patched += 1;
  }

  let added = 0;
  for (const record of NEW_ENTRIES) {
    if (byId.has(record.id)) continue;
    entries.push(record);
    byId.set(record.id, record);
    added += 1;
  }

  window.JJK_KNOWLEDGE = entries;
  window.JJK_CONTENT_META = {
    version: VERSION,
    baseRecords: entries.length - added,
    addedRecords: added,
    patchedRecords: patched,
    totalRecords: entries.length,
    scope: "Original Jujutsu Kaisen manga, anime, and JJK 0; sequel-only material excluded."
  };

  document.documentElement.dataset.contentExpansion = VERSION;
  if (typeof renderHome === "function") renderHome();
  console.info(`[JJK Archive] Content Expansion v${VERSION} active — ${added} added, ${patched} enriched, ${entries.length} total`);
})();
