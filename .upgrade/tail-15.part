swer copied.");
  } catch {
    toast("Copy was blocked by the browser.");
  }
});

renderHome();
refreshLiveCount();
document.documentElement.dataset.appReady = "true";

</script>
<script>
(async()=>{
  const files=[1,2,3,4,5].map(n=>`.upgrade/qv3-${String(n).padStart(2,"0")}.part`);
  document.documentElement.dataset.questionEngine="loading";
  try{
    const parts=await Promise.all(files.map(async file=>{
      const response=await fetch(`${file}?v=20260717q3`,{cache:"no-cache"});
      if(!response.ok)throw new Error(`${file} returned ${response.status}`);
      return response.text();
    }));
    const code=parts.join("");
    if(!code.includes("Question Engine v3")||!code.includes("performSearchV3"))throw new Error("Question engine integrity check failed");
    eval(code);
  }catch(error){
    console.error("Question Engine v3 failed to load",error);
    document.documentElement.dataset.questionEngine="failed";
    try{toast("The upgraded question engine failed to load. Refresh once.");}catch{}
  }
})();
</script>
</body>
</html>