swer copied.");
  } catch {
    toast("Copy was blocked by the browser.");
  }
});

renderHome();
refreshLiveCount();
document.documentElement.dataset.appReady = "true";

</script>
<script>
(async()=>{
  async function fetchText(path, version){
    const response=await fetch(`${path}?v=${version}`,{cache:"no-store"});
    if(!response.ok)throw new Error(`${path} returned ${response.status}`);
    return response.text();
  }

  document.documentElement.dataset.questionEngine="loading";
  try{
    const files=[1,2,3,4,5].map(n=>`.upgrade/qv3-${String(n).padStart(2,"0")}.part`);
    const parts=await Promise.all(files.map(file=>fetchText(file,"20260717motion1")));
    const code=parts.join("");
    if(!code.includes("Question Engine v3")||!code.includes("performSearchV3"))throw new Error("Question Engine v3 integrity check failed");
    eval(code);
    if(document.documentElement.dataset.questionEngine!=="3.0.0")throw new Error("Question Engine v3 did not activate");
  }catch(error){
    console.error("Question Engine v3 failed to load",error);
    document.documentElement.dataset.questionEngine="failed";
    try{toast(`Question engine failed: ${error.message||error}`);}catch{}
    return;
  }

  // Legacy deployment marker: deep-dive-v4.gz.b64
  // The live build now loads ordinary text chunks and does not require DecompressionStream.
  document.documentElement.dataset.deepDossier="loading";
  try{
    const files=[
      ...Array.from({length:7},(_,i)=>`.upgrade/dv4-${String(i+1).padStart(2,"0")}.part`),
      ".upgrade/dv4-08a.part",
      ".upgrade/dv4-08b.part",
      ".upgrade/dv4-09a.part",
      ".upgrade/dv4-09b.part"
    ];
    const parts=await Promise.all(files.map(file=>fetchText(file,"20260717motion1")));
    const code=parts.join("");
    if(!code.includes("Deep Dossier v4")||!code.includes("performSearchV4"))throw new Error("Deep Dossier v4 integrity check failed");
    eval(code);
    if(document.documentElement.dataset.deepDossier!=="4.0.0")throw new Error("Deep Dossier v4 did not activate");

    const css=await fetchText(".upgrade/mobile-layout-v1.css","20260717motion1");
    let style=document.querySelector("#mobile-layout-v1");
    if(!style){style=document.createElement("style");style.id="mobile-layout-v1";document.head.appendChild(style);}
    style.textContent=css;
    document.documentElement.dataset.mobileLayout="1.0.0";
  }catch(error){
    console.error("Deep Dossier v4 failed to load",error);
    document.documentElement.dataset.deepDossier="failed";
    try{toast(`Expanded descriptions failed: ${error.message||error}`);}catch{}
    return;
  }

  document.documentElement.dataset.motionSystem="loading";
  try{
    const code=await fetchText(".upgrade/motion-system-v1.js","20260717motion1");
    if(!code.includes("Motion System v1")||!code.includes("motionPerformSearch"))throw new Error("Motion System v1 integrity check failed");
    eval(code);
    if(document.documentElement.dataset.motionSystem!=="1.0.0")throw new Error("Motion System v1 did not activate");
  }catch(error){
    console.error("Motion System v1 failed to load",error);
    document.documentElement.dataset.motionSystem="failed";
    try{toast(`Animations failed: ${error.message||error}`);}catch{}
  }
})();
</script>
</body>
</html>