/* JJK Archive Complex Reasoning Engine v5
   Handles hypotheticals, motives, encounter history, conditional outcomes, and evidence-aware yes/no questions. */
(() => {
  "use strict";

  const VERSION = "5.0.0";
  const previousPerformSearch = performSearch;

  const qnorm = text => {
    const expanded = String(text || "").toLowerCase().replace(/[’‘]/g, "'")
      .replace(/\bcan't\b/g, "cannot")
      .replace(/\bcouldn't\b/g, "could not")
      .replace(/\bwouldn't\b/g, "would not")
      .replace(/\bdidn't\b/g, "did not")
      .replace(/\bdoesn't\b/g, "does not")
      .replace(/\bhasn't\b/g, "has not")
      .replace(/\bhaven't\b/g, "have not")
      .replace(/\bisn't\b/g, "is not")
      .replace(/\baren't\b/g, "are not");
    return normalize(expanded).replace(/\b([a-z0-9-]+) s\b/g, "$1");
  };

  const unique = (list, key = item => item) => {
    const seen = new Set();
    return list.filter(item => {
      const value = key(item);
      if (seen.has(value)) return false;
      seen.add(value);
      return true;
    });
  };

  const visible = entry => !!entry && (state.spoiler === "manga" || entry.spoiler === "anime");

  function linked(entry, categories = null) {
    if (!entry) return [];
    const direct = (entry.related || []).map(getEntry).filter(Boolean);
    const reverse = entries.filter(candidate => (candidate.related || []).includes(entry.id));
    let result = unique([...direct, ...reverse], item => item.id).filter(visible);
    if (categories?.length) result = result.filter(item => categories.includes(item.category));
    return result;
  }

  const escapeRegex = text => String(text).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  function namePosition(query, name) {
    const match = new RegExp(`(^|\\s)${escapeRegex(name)}(?=$|\\s)`).exec(query);
    return match ? match.index + match[1].length : -1;
  }

  const SPECIAL_REFERENCES = [
    { phrase: "maximum meteor", id: "disaster-flames" },
    { phrase: "jogo domain", id: "coffin-iron-mountain" },
    { phrase: "dagon domain", id: "horizon-skandha" }
  ];

  function mentions(raw, pool = allowedEntries()) {
    const q = qnorm(raw);
    const found = [];
    for (const entry of pool) {
      const names = entryNames(entry).sort((a, b) => b.length - a.length);
      let matched = null;
      let index = -1;
      for (const name of names) {
        const position = namePosition(q, name);
        if (position >= 0) { matched = name; index = position; break; }
      }
      if (matched) found.push({ entry, matched, index });
    }
    for (const reference of SPECIAL_REFERENCES) {
      const index = namePosition(q, reference.phrase);
      const entry = getEntry(reference.id);
      if (index >= 0 && entry && pool.some(candidate => candidate.id === entry.id)) {
        found.push({ entry, matched: reference.phrase, index });
      }
    }
    return unique(found.sort((a, b) => a.index - b.index || b.matched.length - a.matched.length), item => item.entry.id);
  }

  const pairKey = (a, b) => [a, b].sort().join("|");

  const ENCOUNTERS = {
    [pairKey("gojo", "hanami")]: {
      spoiler: "anime",
      verdict: "Yes — Gojo and Hanami directly encountered each other multiple times.",
      events: [
        "Hanami rescued Jogo after Gojo defeated and questioned him during their first clash.",
        "During the Kyoto Goodwill Event, Gojo broke through the curtain and struck Hanami's escape route with Hollow Purple.",
        "In Shibuya, Hanami fought Gojo at close range and Gojo ultimately exorcised Hanami."
      ],
